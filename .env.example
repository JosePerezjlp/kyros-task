# Copy this file to backend/.env for local development.
# In AWS these values are set as Elastic Beanstalk environment properties.

# [required] PostgreSQL connection string used by Prisma (format: postgresql://USER:PASSWORD@HOST:5432/DB)
DATABASE_URL=postgresql://user:password@localhost:5432/taskmanager

# [required] Secret key used to sign and verify JWT tokens (long random string)
JWT_SECRET=your-jwt-secret-here

# [required] Port the backend Express API listens on (number). Elastic Beanstalk uses 8080
PORT=3000

# [required for seed] Email of the initial ADMIN user created by the seed script
ADMIN_EMAIL=admin@example.com

# [required for seed] Password of the initial ADMIN user (min. 8 characters)
ADMIN_PASSWORD=your-admin-password-here

# [optional] "production" hides stack traces in error responses. Default: development
NODE_ENV=development

# [optional] Comma-separated list of allowed CORS origins. Not needed when the SPA and API share the CloudFront domain
CORS_ORIGIN=
