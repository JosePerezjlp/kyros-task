{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && tsc prisma/seed.ts --outDir dist/prisma --module commonjs --target ES2020 --esModuleInterop --skipLibCheck",
    "start": "node dist/server.js",
    "start:prod": "prisma migrate deploy && node dist/prisma/seed.js && node dist/server.js",
    "postinstall": "prisma generate",
    "lint": "eslint --ext .ts src",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.7.1",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.18.2",
    "jsonwebtoken": "9.0.2",
    "prisma": "5.7.1",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.5",
    "@types/node": "20.10.6",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "6.18.1",
    "@typescript-eslint/parser": "6.18.1",
    "eslint": "8.56.0",
    "eslint-plugin-import": "2.29.1",
    "fast-check": "3.15.0",
    "nodemon": "3.0.2",
    "supertest": "6.3.4",
    "ts-node": "10.9.2",
    "typescript": "5.3.3",
    "vitest": "1.1.0"
  }
}
